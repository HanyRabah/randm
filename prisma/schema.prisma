// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELED
}

enum CouponType {
  PERCENT
  FIXED
  FREESHIP
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  SCALE
}

enum TenantStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum TenantMemberRole {
  OWNER
  ADMIN
  STAFF
}

// Auth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  orders            Order[]
  carts             Cart[]
  wishlist          Wishlist[]
  reviews           Review[]
  reviewVotes       ReviewVote[]
  campaigns         NewsletterCampaign[]
  supportTickets    SupportTicket[]
  assignedTickets   SupportTicket[]      @relation("TicketAssignment")
  supportMessages   SupportMessage[]
  tenantMemberships TenantMember[]
}

// Multi-tenancy: a Tenant is one merchant's store.
// Business models get scoped by tenantId in a follow-up migration.
model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique // used as <slug>.storely.app
  name         String
  customDomain            String?      @unique
  customDomainVerifiedAt  DateTime?
  plan         TenantPlan   @default(TRIAL)
  status       TenantStatus @default(ACTIVE)
  trialEndsAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members TenantMember[]

  categories            Category[]
  products              Product[]
  carts                 Cart[]
  orders                Order[]
  coupons               Coupon[]
  popups                Popup[]
  newsletterSubscribers NewsletterSubscriber[]
  newsletterCampaigns   NewsletterCampaign[]
  reviews               Review[]
  wishlistItems         Wishlist[]
  customers             Customer[]
  seoSettings           SeoSettings[]
  supportTickets        SupportTicket[]
  inventoryAlerts       InventoryAlert[]

  @@index([status])
}

model TenantMember {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantMemberRole @default(STAFF)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Category Model
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?
  image       String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// Product Models
model Product {
  id             String        @id @default(cuid())
  title          String
  slug           String
  description    String?       @db.Text
  status         ProductStatus @default(DRAFT)
  basePrice      Decimal       @db.Decimal(10, 2)
  comparePrice   Decimal?      @db.Decimal(10, 2)
  weight         Float?
  tags           String[]
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id])
  variants        Variant[]
  media           Media[]
  options         ProductOption[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   Wishlist[]
  reviews         Review[]
  inventoryAlerts InventoryAlert[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([tenantId])
}

model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String // e.g., "Color", "Size"
  position  Int    @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  OptionValue[]

  @@unique([productId, name])
}

model OptionValue {
  id       String  @id @default(cuid())
  optionId String
  value    String // e.g., "Red", "Large"
  hexColor String? // For color swatches
  position Int     @default(0)

  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants Variant[]     @relation("VariantOptions")

  @@unique([optionId, value])
}

model Variant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  inventory    Int      @default(0)
  weight       Decimal? @db.Decimal(8, 2)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options         OptionValue[]    @relation("VariantOptions")
  media           Media[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventoryAlerts InventoryAlert[]
}

model Media {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

// Coupon Model
model Coupon {
  id             String     @id @default(cuid())
  code           String
  type           CouponType
  value          Decimal    @db.Decimal(10, 2) // Percentage or fixed amount
  minSubtotal    Decimal?   @db.Decimal(10, 2)
  maxRedemptions Int?
  perCustomer    Int?       @default(1)
  usageCount     Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders Order[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

// Cart Models
model Cart {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  variant Variant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

// Customer Model
model Customer {
  id          String   @id @default(cuid())
  email       String
  phone       String?
  firstName   String?
  lastName    String?
  totalOrders Int      @default(0)
  totalSpent  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders         Order[]
  addresses      Address[]
  wishlist       Wishlist[]
  reviews        Review[]
  reviewVotes    ReviewVote[]
  supportTickets SupportTicket[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Address {
  id              String  @id @default(cuid())
  customerId      String?
  userId          String?
  firstName       String
  lastName        String
  company         String?
  line1           String
  line2           String?
  city            String
  state           String
  buildingNumber  String?
  floorNumber     String?
  apartmentNumber String?
  country         String  @default("EG")
  phone           String?
  isDefault       Boolean @default(false)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders   Order[]
}

// Order Models
model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String?
  customerId        String?
  addressId         String
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  shippingCost      Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  couponId          String?
  contactPhone      String
  otpVerified       Boolean     @default(false)
  codCollected      Boolean     @default(false)
  courier           String?
  airwayBill        String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  notes             String?
  exportedAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User?       @relation(fields: [userId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  address  Address     @relation(fields: [addressId], references: [id])
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  reviews  Review[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  quantity     Int
  price        Decimal @db.Decimal(10, 2)
  title        String
  variantTitle String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  variant Variant? @relation(fields: [variantId], references: [id])
}

// Wishlist Model
model Wishlist {
  id         String   @id @default(cuid())
  userId     String?
  customerId String?
  productId  String
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([customerId, productId])
  @@index([tenantId])
}

// Review Model
model Review {
  id           String   @id @default(cuid())
  productId    String
  userId       String?
  customerId   String?
  orderId      String?
  rating       Int // 1-5 stars
  title        String?
  comment      String?  @db.Text
  isVerified   Boolean  @default(false) // Verified purchase
  isApproved   Boolean  @default(false) // Admin approval
  helpfulVotes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  media    ReviewMedia[]
  votes    ReviewVote[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@unique([productId, customerId])
  @@index([tenantId])
}

// Review Media (photos/videos)
model ReviewMedia {
  id       String @id @default(cuid())
  reviewId String
  url      String
  type     String // 'image' | 'video'
  position Int    @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// Review Votes (helpful/not helpful)
model ReviewVote {
  id         String   @id @default(cuid())
  reviewId   String
  userId     String?
  customerId String?
  isHelpful  Boolean
  createdAt  DateTime @default(now())

  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@unique([reviewId, customerId])
}

// Newsletter Subscription Model
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String
  firstName        String?
  lastName         String?
  isActive         Boolean   @default(true)
  preferences      Json? // { categories: string[], frequency: 'weekly' | 'monthly', promotions: boolean }
  source           String? // 'footer', 'popup', 'checkout', 'manual'
  unsubscribeToken String    @unique @default(cuid())
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  lastEmailSent    DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([email])
  @@index([isActive])
  @@index([tenantId])
}

// Newsletter Campaign Model
model NewsletterCampaign {
  id          String    @id @default(cuid())
  title       String
  subject     String
  content     String    @db.Text
  htmlContent String?   @db.Text
  status      String    @default("DRAFT") // DRAFT, SCHEDULED, SENT, CANCELLED
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)
  openCount   Int       @default(0)
  clickCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Inventory Alert Model
model InventoryAlert {
  id            String    @id @default(cuid())
  productId     String?
  variantId     String?
  threshold     Int // Alert when stock falls below this number
  isActive      Boolean   @default(true)
  alertType     String    @default("LOW_STOCK") // LOW_STOCK, OUT_OF_STOCK
  lastAlertSent DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Either product or variant must be set, but not both
  @@index([productId])
  @@index([variantId])
  @@index([isActive])
  @@index([tenantId])
}

// Support Ticket Models
model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique // Auto-generated: TICKET-YYYYMMDD-XXXX
  subject      String
  description  String @db.Text
  status       String @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category     String @default("GENERAL") // GENERAL, ORDER, PRODUCT, TECHNICAL, BILLING

  // Customer info
  userId        String?
  customerId    String?
  customerName  String?
  customerEmail String
  customerPhone String?

  // Assignment
  assignedToId String?
  assignedAt   DateTime?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  // Relations
  user       User?            @relation(fields: [userId], references: [id])
  customer   Customer?        @relation(fields: [customerId], references: [id])
  assignedTo User?            @relation("TicketAssignment", fields: [assignedToId], references: [id])
  messages   SupportMessage[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([tenantId])
}

model SupportMessage {
  id             String  @id @default(cuid())
  ticketId       String
  content        String  @db.Text
  isFromCustomer Boolean @default(true)

  // Sender info
  userId        String?
  customerEmail String?
  senderName    String

  // Message metadata
  isInternal  Boolean  @default(false) // Internal notes not visible to customer
  attachments Json? // Array of file URLs
  createdAt   DateTime @default(now())

  // Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

// Popup Model
model Popup {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  ctaText     String?
  ctaUrl      String?
  targeting   Json // { paths: string[], devices: ('mobile'|'desktop')[], utm?: string[] }
  capping     Json // { perSession?: number; perDay?: number; cooldownHours?: number }
  schedule    Json? // { startDate?: string; endDate?: string; timeRanges?: { start: string; end: string }[] }
  abGroup     String? // 'A' | 'B' | null
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// SEO Settings Model
model SeoSettings {
  id                 String   @id @default(cuid())
  siteName           String   @default("My Store")
  siteDescription    String   @default("")
  primaryColor       String   @default("#111827") // slate-900
  accentColor        String   @default("#4f46e5") // indigo-600
  siteKeywords       String[] @default(["furniture", "home decor", "cash on delivery", "Egypt"])
  siteUrl            String   @default("https://rmstore.com")
  logoUrl            String?
  faviconUrl         String?
  ogImageUrl         String?
  twitterHandle      String?
  facebookUrl        String?
  instagramUrl       String?
  linkedinUrl        String?
  googleAnalyticsId  String?
  googleTagManagerId String?
  facebookPixelId    String?
  metaRobots         String   @default("index, follow")
  currency           String   @default("EGP")
  currencySymbol     String   @default("EGP")
  language           String   @default("ar")
  country            String   @default("Egypt")
  timezone           String   @default("Africa/Cairo")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
